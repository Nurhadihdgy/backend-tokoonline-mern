{
	"info": {
		"_postman_id": "toko-online-nurhadi",
		"name": "Toko Online Nurhadi API",
		"description": "REST API untuk Toko Online Nurhadi - Auth, Products, Cart, Orders.\n\nSetup:\n1. Set variable `base_url` sesuai server (default: http://localhost:5000/api)\n2. Login dulu, token otomatis tersimpan di variable `token`\n3. Semua request yang butuh auth sudah otomatis pakai Bearer token",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "product_id",
			"value": ""
		},
		{
			"key": "order_id",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						},
						"description": "Register user baru. Role otomatis 'user'. Admin hanya bisa dibuat langsung via database."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"    console.log('Token saved!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Login dan dapatkan JWT token. Token otomatis tersimpan di collection variable."
					}
				}
			],
			"description": "Endpoint autentikasi (register & login). Tidak perlu token."
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get All Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						},
						"description": "Ambil semua produk. Butuh auth."
					}
				},
				{
					"name": "Get Product by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}",
							"host": ["{{base_url}}"],
							"path": ["products", "{{product_id}}"]
						},
						"description": "Ambil detail produk berdasarkan ID."
					}
				},
				{
					"name": "Create Product (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.product && jsonData.product._id) {",
									"    pm.collectionVariables.set('product_id', jsonData.product._id);",
									"    console.log('Product ID saved: ' + jsonData.product._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "name", "value": "Produk Contoh", "type": "text" },
								{ "key": "price", "value": "50000", "type": "text" },
								{ "key": "description", "value": "Deskripsi produk contoh", "type": "text" },
								{ "key": "category", "value": "Elektronik", "type": "text" },
								{ "key": "stock", "value": "100", "type": "text" },
								{ "key": "image", "type": "file", "src": "" }
							]
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						},
						"description": "Buat produk baru. Hanya admin. Gunakan form-data untuk upload gambar. Product ID otomatis tersimpan."
					}
				},
				{
					"name": "Update Product (Admin)",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "name", "value": "Produk Updated", "type": "text" },
								{ "key": "price", "value": "75000", "type": "text" },
								{ "key": "description", "value": "Deskripsi updated", "type": "text" },
								{ "key": "category", "value": "Elektronik", "type": "text" },
								{ "key": "stock", "value": "50", "type": "text" },
								{ "key": "image", "type": "file", "src": "" }
							]
						},
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}",
							"host": ["{{base_url}}"],
							"path": ["products", "{{product_id}}"]
						},
						"description": "Update produk. Hanya admin. Bisa upload gambar baru."
					}
				},
				{
					"name": "Delete Product (Admin)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}",
							"host": ["{{base_url}}"],
							"path": ["products", "{{product_id}}"]
						},
						"description": "Hapus produk. Hanya admin."
					}
				}
			],
			"description": "CRUD Produk. GET untuk semua user, POST/PUT/DELETE hanya admin."
		},
		{
			"name": "Cart (User Only)",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/cart",
							"host": ["{{base_url}}"],
							"path": ["cart"]
						},
						"description": "Ambil keranjang user. Items sudah di-populate dengan data produk."
					}
				},
				{
					"name": "Add to Cart",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/cart",
							"host": ["{{base_url}}"],
							"path": ["cart"]
						},
						"description": "Tambah produk ke keranjang. Jika produk sudah ada, quantity ditambah."
					}
				},
				{
					"name": "Update Cart Item Quantity",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 3\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/cart/{{product_id}}",
							"host": ["{{base_url}}"],
							"path": ["cart", "{{product_id}}"]
						},
						"description": "Update quantity item di keranjang. Minimum 1."
					}
				},
				{
					"name": "Remove Item from Cart",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/cart/{{product_id}}",
							"host": ["{{base_url}}"],
							"path": ["cart", "{{product_id}}"]
						},
						"description": "Hapus satu item dari keranjang berdasarkan product ID."
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/cart",
							"host": ["{{base_url}}"],
							"path": ["cart"]
						},
						"description": "Kosongkan semua item di keranjang."
					}
				}
			],
			"description": "Keranjang belanja. Hanya bisa diakses oleh role 'user'."
		},
		{
			"name": "Orders (User Only)",
			"item": [
				{
					"name": "Checkout",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.order && jsonData.order._id) {",
									"    pm.collectionVariables.set('order_id', jsonData.order._id);",
									"    console.log('Order ID saved: ' + jsonData.order._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"paymentMethod\": \"qris\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/orders/checkout",
							"host": ["{{base_url}}"],
							"path": ["orders", "checkout"]
						},
						"description": "Checkout dari keranjang. paymentMethod: 'cash' atau 'qris'.\n- Cash: langsung paid & forwarded_to_seller\n- QRIS: pending, perlu cek pembayaran\n\nKeranjang otomatis dikosongkan. Order ID otomatis tersimpan."
					}
				},
				{
					"name": "Check Payment (QRIS)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/orders/{{order_id}}/check-payment",
							"host": ["{{base_url}}"],
							"path": ["orders", "{{order_id}}", "check-payment"]
						},
						"description": "Simulasi cek pembayaran QRIS. Otomatis set status paid & forwarded_to_seller."
					}
				},
				{
					"name": "Get Order by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/orders/{{order_id}}",
							"host": ["{{base_url}}"],
							"path": ["orders", "{{order_id}}"]
						},
						"description": "Ambil detail order berdasarkan ID."
					}
				},
				{
					"name": "Get All Orders",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/orders",
							"host": ["{{base_url}}"],
							"path": ["orders"]
						},
						"description": "Ambil semua order milik user, diurutkan dari terbaru."
					}
				}
			],
			"description": "Order & Checkout. Hanya role 'user'. Flow: Cart → Checkout → (QRIS: Check Payment) → Selesai."
		}
	]
}
